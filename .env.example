# HTTP server tinglaydigan port.
PORT=3000
# Redis ulanish manzili.
REDIS_URL=redis://localhost:6379
# Google Cloud Console'dagi Web OAuth client ID.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Frontend manzili; production'da aniq origin ko'rsating.
CORS_ORIGIN=http://localhost:3000
# Bir natija uchun ruxsat etilgan maksimal vaqt, nanosekundlarda.
MAX_RESULT_NS=60000000000
# Rate limit oynasidagi maksimal submit soni.
SUBMIT_RATE_LIMIT=30
